<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SignalProof — Become the Brand AI Recommends</title>

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400&display=swap" rel="stylesheet">

/* ── TOKENS ─────────────────────────────────────────── */
:root {
  --slate:      #334049;
  --blue:       #a6bac8;
  --mint:       #d1e6d2;
  --black:      #1a1a1a;
  --white:      #fafafa;
  --mid:        #1a1a1a;
  --border:     rgba(51,64,73,0.12);
  --serif:      Helvetica, Arial, sans-serif;
  --heading: Helvetica, Arial, sans-serif;
  --body: Helvetica, Arial, sans-serif;
}

/* ── RESET ──────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--heading);
  background: var(--white);
  color: var(--black);
  -webkit-font-smoothing: antialiased;
}

/* ── UTILITIES ──────────────────────────────────────── */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 32px;
}

.label {
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--mid);
}

/* ── NAV ────────────────────────────────────────────── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(250,250,250,0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 32px;
}

.wordmark {
  font-family: 'Syne', sans-serif;
  font-size: 18px;
  font-weight: 400;
  color: var(--black);
  text-decoration: none;
  letter-spacing: 0.02em;
}

.footer-wordmark {
  font-family: 'Syne', sans-serif;
  font-size: 16px;
  font-weight: 400;
  color: var(--white);
  text-decoration: none;
  opacity: 0.85;
}

.logo-img {
  height: 28px;
  width: auto;
  display: block;
  filter: invert(1);
}

.logo-light {
  height: 24px;
  filter: none;
  opacity: 0.9;
}

.nav-cta {
  background: var(--slate);
  color: var(--white);
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 700;
  padding: 10px 22px;
  border-radius: 6px;
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: opacity 0.2s;
}
.nav-cta:hover { opacity: 0.85; }

/* ── HERO ───────────────────────────────────────────── */
.hero {
  padding: 160px 0 100px;
  position: relative;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 70% 40%, rgba(166,186,200,0.18) 0%, transparent 70%),
    radial-gradient(ellipse 40% 60% at 20% 80%, rgba(209,230,210,0.15) 0%, transparent 60%);
  pointer-events: none;
}

.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
  opacity: 0.5;
  pointer-events: none;
}

.hero-inner {
  position: relative;
  z-index: 1;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 32px;
}

.hero-icon {
  margin-bottom: 28px;
}

.hero-icon-img {
  width: 52px;
  height: 52px;
  object-fit: contain;
  filter: invert(1);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--mint);
  border-radius: 100px;
  padding: 6px 14px 6px 8px;
  margin-bottom: 32px;
}

.badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--slate);
  flex-shrink: 0;
}

.badge-text {
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--slate);
}

h1 {
  font-family: var(--serif);
  font-size: clamp(42px, 6vw, 76px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: var(--black);
  max-width: 820px;
  margin-bottom: 28px;
}

h1 em {
  font-style: normal;
  color: var(--slate);
}

.hero-sub {
  font-size: 18px;
  line-height: 1.65;
  color: var(--mid);
  max-width: 540px;
  margin-bottom: 48px;
  font-weight: 400;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.btn-primary {
  background: var(--slate);
  color: var(--white);
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 700;
  padding: 16px 36px;
  border-radius: 8px;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: opacity 0.2s, transform 0.2s;
  display: inline-block;
}
.btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }

.btn-ghost {
  font-family: var(--serif);
  font-size: 16px;
  font-weight: 600;
  color: var(--slate);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-bottom: 1.5px solid var(--blue);
  padding-bottom: 2px;
}

.hero-proof {
  margin-top: 56px;
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.proof-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  color: var(--mid);
}

.proof-icon {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--mint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
}

.proof-divider {
  width: 1px;
  height: 16px;
  background: var(--border);
}

/* ── PROBLEM ────────────────────────────────────────── */
.problem {
  padding: 100px 0;
  background: var(--slate);
  color: var(--white);
  position: relative;
  overflow: hidden;
}

.problem::before {
  content: '';
  position: absolute;
  top: -1px; left: 0; right: 0;
  height: 1px;
  background: rgba(166,186,200,0.3);
}

.problem-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.problem-label { color: var(--blue); margin-bottom: 20px; }

.problem h2 {
  font-family: var(--serif);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--white);
  margin-bottom: 24px;
}

.problem-body {
  font-size: 16px;
  line-height: 1.75;
  color: rgba(250,250,250,0.9);
  font-weight: 400;
}

.problem-stats {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.stat-card {
  background: rgba(166,186,200,0.1);
  border: 1px solid rgba(166,186,200,0.15);
  border-radius: 12px;
  padding: 28px 32px;
}

.stat-card + .stat-card { margin-top: 12px; }

.stat-number {
  font-family: var(--serif);
  font-size: 42px;
  font-weight: 800;
  color: var(--blue);
  letter-spacing: -0.03em;
  line-height: 1;
  margin-bottom: 6px;
}

.stat-label {
  font-size: 16px;
  color: rgba(250,250,250,0.88);
  line-height: 1.5;
}

/* ── FRAMEWORK ──────────────────────────────────────── */
.framework {
  padding: 100px 0;
  background: var(--white);
}

.section-header {
  text-align: center;
  margin-bottom: 64px;
}

.section-header .label { margin-bottom: 16px; display: block; }

.section-header h2 {
  font-family: var(--serif);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--black);
  margin-bottom: 16px;
}

.section-header p {
  font-size: 17px;
  color: var(--mid);
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.65;
  font-weight: 400;
}

.pillars {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 24px;
}

.pillar {
  border-radius: 16px;
  padding: 48px 44px;
  position: relative;
  overflow: hidden;
}

.pillar-signal {
  background: var(--slate);
  color: var(--white);
}

.pillar-proof {
  background: #f0f4f6;
  color: var(--black);
}

.pillar-tag {
  font-family: var(--serif);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 12px;
  opacity: 0.5;
}

.pillar h3 {
  font-family: var(--serif);
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 8px;
}

.pillar-subtitle {
  font-size: 15px;
  opacity: 0.6;
  margin-bottom: 32px;
  font-weight: 400;
}

.pillar-items {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pillar-items li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 16px;
  line-height: 1.5;
}

.pillar-signal .pillar-items li { color: rgba(250,250,250,0.95); }
.pillar-proof .pillar-items li { color: var(--mid); }

.pillar-bullet {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6px;
}

.pillar-signal .pillar-bullet { background: var(--blue); }
.pillar-proof .pillar-bullet { background: var(--slate); }

/* ── WHAT YOU GET ───────────────────────────────────── */
.whats-inside {
  padding: 100px 0;
  background: #f0f4f6;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.tool-card {
  background: var(--white);
  border-radius: 12px;
  padding: 32px 28px;
  border: 1px solid var(--border);
  transition: transform 0.2s, box-shadow 0.2s;
}

.tool-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(51,64,73,0.08);
}

.tool-icon {
  font-size: 24px;
  margin-bottom: 16px;
  display: block;
}

.tool-card h4 {
  font-family: var(--serif);
  font-size: 16px;
  font-weight: 700;
  color: var(--black);
  margin-bottom: 8px;
  letter-spacing: -0.01em;
}

.tool-card p {
  font-size: 15px;
  color: var(--mid);
  line-height: 1.6;
}

/* ── SPRINT ─────────────────────────────────────────── */
.sprint {
  padding: 100px 0;
  background: var(--white);
}

.sprint-weeks {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid var(--border);
}

.week {
  padding: 36px 28px;
  position: relative;
}

.week:nth-child(1) { background: var(--slate); }
.week:nth-child(2) { background: #3d4f5a; }
.week:nth-child(3) { background: #47606d; }
.week:nth-child(4) { background: #517080; }

.week-number {
  font-family: var(--serif);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 8px;
}

.week h4 {
  font-family: var(--serif);
  font-size: 18px;
  font-weight: 800;
  color: var(--white);
  margin-bottom: 12px;
  letter-spacing: -0.01em;
}

.week p {
  font-size: 15px;
  color: rgba(250,250,250,0.88);
  line-height: 1.6;
}

.week-outcome {
  margin-top: 20px;
  font-size: 16px;
  font-family: var(--serif);
  font-weight: 600;
  color: var(--blue);
  letter-spacing: 0.05em;
}

/* ── FOR WHO ────────────────────────────────────────── */
.for-who {
  padding: 100px 0;
  background: #f0f4f6;
}

.for-who-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.for-card {
  background: var(--white);
  border-radius: 16px;
  padding: 44px 40px;
  border: 1px solid var(--border);
}

.for-card h3 {
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 800;
  color: var(--black);
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}

.for-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.for-list li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 16px;
  color: var(--mid);
  line-height: 1.55;
}

.check {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--mint);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 16px;
  color: var(--slate);
  font-weight: 700;
  margin-top: 1px;
}

.cross {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #fde8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 16px;
  color: #c0392b;
  font-weight: 700;
  margin-top: 1px;
}

/* ── PRICING ────────────────────────────────────────── */
.pricing {
  padding: 100px 0;
  background: var(--white);
}

.pricing-card {
  max-width: 560px;
  margin: 0 auto;
  background: var(--slate);
  border-radius: 20px;
  padding: 56px 52px;
  color: var(--white);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.pricing-card::before {
  content: '';
  position: absolute;
  top: -80px; right: -80px;
  width: 260px; height: 260px;
  border-radius: 50%;
  background: rgba(166,186,200,0.1);
  pointer-events: none;
}

.pricing-card::after {
  content: '';
  position: absolute;
  bottom: -60px; left: -60px;
  width: 200px; height: 200px;
  border-radius: 50%;
  background: rgba(209,230,210,0.08);
  pointer-events: none;
}

.pricing-badge {
  display: inline-block;
  background: var(--mint);
  color: var(--slate);
  font-family: var(--serif);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 100px;
  margin-bottom: 28px;
}

.pricing-name {
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 12px;
}

.pricing-price-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 16px;
  margin-bottom: 4px;
}

.pricing-was {
  font-size: 36px;
  font-weight: 400;
  color: rgba(250,250,250,0.35);
  text-decoration: line-through;
  line-height: 1;
  padding-bottom: 10px;
}

.pricing-price {
  font-family: var(--heading);
  font-size: 72px;
  font-weight: 700;
  letter-spacing: -0.04em;
  color: var(--white);
  line-height: 1;
}

.pricing-price sup {
  font-size: 32px;
  vertical-align: super;
  font-weight: 400;
}

.pricing-note {
  font-size: 15px;
  color: rgba(250,250,250,0.5);
  margin-bottom: 36px;
}

.pricing-includes {
  list-style: none;
  text-align: left;
  margin-bottom: 40px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.pricing-includes li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 16px;
  color: rgba(250,250,250,0.95);
}

.pricing-includes .check {
  background: rgba(209,230,210,0.2);
  color: var(--mint);
}

.btn-buy {
  display: block;
  background: var(--white);
  color: var(--slate);
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 800;
  padding: 18px 40px;
  border-radius: 10px;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: opacity 0.2s, transform 0.2s;
  position: relative;
  z-index: 1;
}
.btn-buy:hover { opacity: 0.92; transform: translateY(-1px); }

.pricing-guarantee {
  margin-top: 20px;
  font-size: 16px;
  color: rgba(250,250,250,0.4);
  position: relative;
  z-index: 1;
}

/* ── FAQ ────────────────────────────────────────────── */
.faq {
  padding: 100px 0;
  background: #f0f4f6;
}

.faq-grid {
  max-width: 720px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.faq-item {
  background: var(--white);
  border-radius: 10px;
  border: 1px solid var(--border);
  overflow: hidden;
}

.faq-q {
  padding: 22px 28px;
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 700;
  color: var(--black);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}

.faq-icon {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--mint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: var(--slate);
  flex-shrink: 0;
  font-weight: 700;
  line-height: 1;
}

.faq-a {
  padding: 0 28px 22px;
  font-size: 16px;
  color: var(--mid);
  line-height: 1.7;
}

/* ── CTA ────────────────────────────────────────────── */
.cta-section {
  padding: 120px 0;
  background: var(--slate);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.cta-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(166,186,200,0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(166,186,200,0.08) 1px, transparent 1px);
  background-size: 48px 48px;
}

.cta-inner { position: relative; z-index: 1; }

.cta-section .label { color: var(--blue); margin-bottom: 24px; display: block; }

.cta-section h2 {
  font-family: var(--serif);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--white);
  max-width: 640px;
  margin: 0 auto 20px;
  line-height: 1.1;
}

.cta-section p {
  font-size: 16px;
  color: rgba(250,250,250,0.88);
  margin-bottom: 44px;
  max-width: 420px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.65;
  font-weight: 400;
}

.cta-section .btn-buy {
  display: inline-block;
  padding: 18px 52px;
}

.cta-sub {
  margin-top: 16px;
  font-size: 16px;
  color: rgba(250,250,250,0.35);
}

/* ── FOOTER ─────────────────────────────────────────── */
footer {
  background: var(--black);
  padding: 40px 0;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}




.footer-copy {
  font-size: 16px;
  color: rgba(250,250,250,0.3);
}

.footer-links {
  display: flex;
  gap: 24px;
}

.footer-links a {
  font-size: 16px;
  color: rgba(250,250,250,0.4);
  text-decoration: none;
}
.footer-links a:hover { color: rgba(250,250,250,0.7); }

/* ── ANIMATIONS ─────────────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero-badge  { animation: fadeUp 0.5s ease both; }
h1           { animation: fadeUp 0.5s 0.1s ease both; }
.hero-sub    { animation: fadeUp 0.5s 0.2s ease both; }
.hero-actions{ animation: fadeUp 0.5s 0.3s ease both; }
.hero-proof  { animation: fadeUp 0.5s 0.4s ease both; }

/* ── RESPONSIVE ─────────────────────────────────────── */
@media (max-width: 768px) {
  .problem-inner { grid-template-columns: 1fr; gap: 48px; }
  .pillars { grid-template-columns: 1fr; }
  .tools-grid { grid-template-columns: 1fr 1fr; }
  .sprint-weeks { grid-template-columns: 1fr 1fr; }
  .for-who-grid { grid-template-columns: 1fr; }
  .pricing-card { padding: 40px 32px; }
  .nav-cta { display: none; }
}

@media (max-width: 480px) {
  .tools-grid { grid-template-columns: 1fr; }
  .sprint-weeks { grid-template-columns: 1fr; }
}

</style>
</head>
<body>

<!-- NAV -->
